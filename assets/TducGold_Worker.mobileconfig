<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>Locket Gold DNS - @tduc 💛</string>

    <key>PayloadDescription</key>
    <string>Anti-Revoke DNS tự viết by @tduc. Chặn thu hồi Locket Gold vĩnh viễn. Chạy trên Cloudflare Worker - không phụ thuộc bên thứ ba.</string>

    <key>PayloadIdentifier</key>
    <string>com.tduc.locketgold.dns.worker</string>

    <key>PayloadOrganization</key>
    <string>tduc</string>

    <key>PayloadScope</key>
    <string>System</string>

    <key>PayloadType</key>
    <string>Configuration</string>

    <key>PayloadUUID</key>
    <!-- UUID này là duy nhất, KHÔNG thay đổi nếu không muốn iOS coi là profile mới -->
    <string>7F3A1B2C-4D5E-6F7A-8B9C-0D1E2F3A4B5C</string>

    <key>PayloadVersion</key>
    <integer>1</integer>

    <key>PayloadRemovalDisallowed</key>
    <false/>

    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>

            <key>PayloadIdentifier</key>
            <string>com.tduc.locketgold.dns.worker.settings</string>

            <key>PayloadDisplayName</key>
            <string>TducGold Worker DNS Engine</string>

            <key>PayloadOrganization</key>
            <string>tduc</string>

            <key>PayloadUUID</key>
            <string>1A2B3C4D-5E6F-7A8B-9C0D-1E2F3A4B5C6D</string>

            <key>PayloadVersion</key>
            <integer>1</integer>

            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>

                <!--
                    ╔══════════════════════════════════════════════════════╗
                    ║  SAU KHI DEPLOY CLOUDFLARE WORKER:                  ║
                    ║  Thay URL dưới đây bằng URL worker của bạn.         ║
                    ║  Ví dụ: https://locket-dns.YOUR_NAME.workers.dev    ║
                    ╚══════════════════════════════════════════════════════╝
                -->
                <key>ServerURL</key>
                <string>https://locketgold.duc-lht-dev.workers.dev/dns-query</string>

                <!--
                    ServerAddresses: IP của Cloudflare Workers.
                    iOS dùng IP này để kết nối khi hostname chưa resolve được.
                    Đây là IP cố định của Cloudflare anycast - không cần đổi.
                -->
                <key>ServerAddresses</key>
                <array>
                    <string>104.16.0.0</string>
                    <string>104.17.0.0</string>
                    <string>2606:4700::</string>
                </array>

                <!--
                    SupplementalMatchDomains = SPLIT DNS
                    CHỈ các domain này mới đi qua Worker của bạn.
                    Toàn bộ domain khác (bank, mạng xã hội...) dùng DNS nhà mạng.
                    → An toàn 100%, không lo lộ dữ liệu.
                -->
                <key>SupplementalMatchDomains</key>
                <array>
                    <!-- ★ RevenueCat: Hệ thống kiểm tra và thu hồi Gold ★ -->
                    <string>revenuecat.com</string>
                    <string>api.revenuecat.com</string>
                    <string>app.revenuecat.com</string>
                    <string>www.revenuecat.com</string>
                    <string>purchases.revenuecat.com</string>
                    <string>sdk.revenuecat.com</string>
                    <string>backend.revenuecat.com</string>

                    <!-- ★ Firebase: Tải cấu hình tính năng Gold & Frame (Được whitelist mở) ★ -->
                    <string>firebaseremoteconfig.googleapis.com</string>
                    <string>firebaseinstallations.googleapis.com</string>

                    <!-- ★ Telemetry & Analytics: Chặn theo dõi và gửi log hành vi người dùng ★ -->
                    <string>in.appcenter.ms</string>
                    <string>app-measurement.com</string>
                    <string>mixpanel.com</string>
                    <string>api.mixpanel.com</string>
                    <string>firebaselogging-pa.googleapis.com</string>
                    <string>firebaselogging.googleapis.com</string>
                    <string>ingest.sentry.io</string>
                    <string>api2.amplitude.com</string>
                    <string>appsflyersdk.com</string>
                    <string>oy24bn.skadsdkless.appsflyersdk.com</string>

                    <!-- ★ Chống thu hồi chứng chỉ Apple (Anti-Revoke Cert) ★ -->
                    <string>certs.apple.com</string>
                    <string>certs.apple.com.edgekey.net</string>
                    <string>crl.apple.com</string>
                    <string>crl.apple.com.akadns.net</string>
                    <string>crl.apple.com.edgekey.net</string>
                    <string>ocsp.apple.com</string>
                    <string>ocsp.apple.com.edgekey.net</string>
                    <string>ocsp2.apple.com</string>
                </array>
            </dict>

            <!--
                OnDemandRules: Cơ chế kích hoạt thông minh
                - Tự động bỏ qua Captive Portal (WiFi quán cafe, sân bay cần đăng nhập)
                - Tự động bật trên tất cả mạng WiFi và 4G/5G
            -->
            <key>OnDemandRules</key>
            <array>
                <dict>
                    <key>Action</key>
                    <string>EvaluateConnection</string>
                    <key>ActionParameters</key>
                    <array>
                        <dict>
                            <key>DomainAction</key>
                            <string>NeverConnect</string>
                            <key>Domains</key>
                            <array>
                                <string>captive.apple.com</string>
                                <string>3gppnetwork.org</string>
                                <string>appleiphonecell.com</string>
                            </array>
                        </dict>
                    </array>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                </dict>
            </array>
        </dict>
    </array>
</dict>
</plist>

