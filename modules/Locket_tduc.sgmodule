#!url=https://raw.githubusercontent.com/tduck1412/LocketGold/dev/modules/Locket_tduc.sgmodule
#!name=Locket Gold VIP - tduc
#!desc=Mở khóa Locket Gold VIP vĩnh viễn (RevenueCat + Firebase Remote Config + Profile Badge). Phát hành bởi tduc (https://www.facebook.com/tduck.2007/).
#!author=tduc

[Script]
# Mở khóa gói Locket Gold qua RevenueCat
revenuecat = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/tduck1412/LocketGold/dev/js/Locket_tduc.js, requires-body=true, max-size=-1, timeout=60

# Xóa ETag header để luôn nhận phản hồi mới từ RevenueCat
deleteHeader = type=http-request, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/tduck1412/LocketGold/dev/js/deleteHeader.js, timeout=60

# Mở khóa toàn bộ Remote Config (Camera HD 1.0, Bitrate 0.9, 100+ Caption, Theme & Icon)
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/tduck1412/LocketGold/dev/js/Locket_Unlocked.js, requires-body=true, max-size=-1, timeout=60

# Giữ Huy hiệu Locket Gold luôn BẬT và đồng bộ thông tin tài khoản
locket_badge = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/changeProfileInfo, script-path=https://raw.githubusercontent.com/tduck1412/LocketGold/dev/js/locket_profile.js, timeout=60
locket_user = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/.+, script-path=https://raw.githubusercontent.com/tduck1412/LocketGold/dev/js/locket_profile.js, requires-body=true, max-size=-1, timeout=60

#locket_rc_us = type=http-request, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch, requires-body=true, max-size=-1, script-path=https://raw.githubusercontent.com/tduck1412/LocketGold/dev/js/Locket_rc_us.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com
